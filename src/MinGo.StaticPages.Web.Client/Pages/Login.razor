@page "/login"
@layout EmptyLayout
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject HttpClient Http

<PageTitle>登录</PageTitle>

<div class="login-wrap">
    <div class="login-card">
        <h1>MinGo Static Pages</h1>
        <p class="muted">自托管版本化静态资源仓库</p>
        <div class="field">
            <label>用户名</label>
            <input class="form-control" @bind="model.Username" />
        </div>
        <div class="field">
            <label>密码</label>
            <input type="password" class="form-control" @bind="model.Password" />
        </div>
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert">@error</div>
        }
        <button class="btn-primary" type="button" disabled="@busy" @onclick="LoginAsync">登录</button>
        <p class="hint">默认管理员：admin / admin123</p>
    </div>
</div>

@code {
    private LoginModel model = new();
    private string? error;
    private bool busy;

    private async Task LoginAsync()
    {
        busy = true;
        error = null;
        try
        {
            var resp = await Http.PostAsJsonAsync("/api/auth/login", new LoginRequest(model.Username, model.Password));
            if (resp.IsSuccessStatusCode)
            {
                Nav.NavigateTo("/projects", forceLoad: true);
            }
            else
            {
                error = "用户名或密码错误";
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private sealed class LoginModel
    {
        public string Username { get; set; } = "admin";
        public string Password { get; set; } = "admin123";
    }
}
