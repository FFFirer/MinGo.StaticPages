@page "/projects"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>项目</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">项目</h1>
    <button class="btn btn-primary" @onclick="() => showCreate = true">新建项目</button>
</div>

@if (loading)
{
    <div class="placeholder-glow">
        <span class="placeholder col-12 mb-2"></span>
        <span class="placeholder col-12"></span>
    </div>
}
else if (projects is null || projects.Count == 0)
{
    <div class="card">
        <div class="card-body text-center text-body-secondary py-5">
            暂无项目，点击「新建项目」开始。
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-group-divider">
                    <tr>
                        <th>名称</th>
                        <th>显示名</th>
                        <th>存储实例</th>
                        <th class="text-end">版本数</th>
                        <th class="text-end">存储</th>
                        <th>production</th>
                        <th>preview</th>
                        <th class="text-end">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in projects)
                    {
                        <tr>
                            <td><a href="/projects/@p.Id">@p.Name</a></td>
                            <td class="text-body-secondary">@p.DisplayName</td>
                            <td><span class="badge text-bg-light border">@p.StorageInstanceName</span></td>
                            <td class="text-end">@p.VersionCount</td>
                            <td class="text-end">@FormatSize(p.StorageBytes)</td>
                            <td><span class="badge text-bg-success">@ChannelVersion(p, "production")</span></td>
                            <td><span class="badge text-bg-secondary">@ChannelVersion(p, "preview")</span></td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(p)">删除</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (showCreate)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,.35)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5">新建项目</h2>
                    <button type="button" class="btn-close" @onclick="() => showCreate = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">名称（小写字母数字 - _ .）</label>
                        <input class="form-control" @bind="newName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">存储实例（创建后不可改）</label>
                        <select class="form-select" @bind="newInstanceId">
                            <option value="">— 请选择 —</option>
                            @if (instances is not null)
                            {
                                @foreach (var i in instances)
                                {
                                    <option value="@i.Id">@i.Name (@i.Kind)</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">显示名</label>
                        <input class="form-control" @bind="newDisplay" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">描述</label>
                        <input class="form-control" @bind="newDesc" />
                    </div>
                    @if (!string.IsNullOrEmpty(error))
                    {
                        <div class="alert alert-danger py-2">@error</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="() => showCreate = false">取消</button>
                    <button class="btn btn-primary" @onclick="CreateAsync">创建</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ProjectDto>? projects;
    private List<StorageInstanceDto>? instances;
    private bool loading = true;
    private bool showCreate;
    private string newName = "";
    private string newInstanceId = "";
    private string? newDisplay, newDesc, error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            projects = await Http.GetFromJsonAsync<List<ProjectDto>>("/api/projects");
            try { instances = await Http.GetFromJsonAsync<List<StorageInstanceDto>>("/api/storage-instances"); }
            catch { instances = []; }
        }
        catch (Exception ex) { error = ex.Message; }
        loading = false;
        StateHasChanged();
    }

    private async Task CreateAsync()
    {
        error = null;
        if (!Guid.TryParse(newInstanceId, out var instanceId))
        {
            error = "请选择存储实例。";
            return;
        }
        var resp = await Http.PostAsJsonAsync("/api/projects", new CreateProjectRequest(newName, instanceId, newDisplay, newDesc));
        if (resp.IsSuccessStatusCode)
        {
            showCreate = false;
            newName = "";
            newInstanceId = "";
            await LoadAsync();
        }
        else
        {
            error = await resp.Content.ReadAsStringAsync();
        }
    }

    private async Task DeleteAsync(ProjectDto p)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"删除项目 {p.Name}？")) return;
        await Http.DeleteAsync($"/api/projects/{p.Id}");
        await LoadAsync();
    }

    private static string FormatSize(long bytes) =>
        bytes > 1_000_000_000 ? $"{bytes / 1e9:F2} GB" :
        bytes > 1_000_000 ? $"{bytes / 1e6:F1} MB" :
        bytes > 1_000 ? $"{bytes / 1e3:F1} KB" : $"{bytes} B";

    private static string ChannelVersion(ProjectDto p, string name) =>
        p.Channels.FirstOrDefault(c => c.Name == name)?.CurrentVersionNumber ?? "—";
}
