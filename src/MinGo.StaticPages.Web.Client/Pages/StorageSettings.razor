@page "/settings/storage"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@inject HttpClient Http

<PageTitle>存储设置</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">存储设置</h1>
    <button class="btn btn-outline-secondary" @onclick="TestAsync">连通性测试</button>
</div>

@if (form is null)
{
    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-danger">@message</div>
    }
    else
    {
        <div class="text-body-secondary">正在加载设置…</div>
    }
}
else
{
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h6 text-body-secondary">对象存储</h2>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Provider</label>
                    <select class="form-select" @bind="form.Provider">
                        <option value="Local">Local</option>
                        <option value="S3">S3</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Service URL（S3）</label>
                    <input class="form-control" @bind="form.ServiceUrl" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Region</label>
                    <input class="form-control" @bind="form.Region" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Access Key</label>
                    <input class="form-control" @bind="form.AccessKey" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Secret Key（留空不改）</label>
                    <input type="password" class="form-control" @bind="secretKey" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Bucket</label>
                    <input class="form-control" @bind="form.Bucket" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Prefix</label>
                    <input class="form-control" @bind="form.Prefix" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Local Root</label>
                    <input class="form-control" @bind="form.LocalRoot" />
                </div>
                <div class="col-md-6">
                    <div class="form-check form-switch mt-4">
                        <input class="form-check-input" type="checkbox" id="forcePath" @bind="form.ForcePathStyle" />
                        <label class="form-check-label" for="forcePath">Force Path Style</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h6 text-body-secondary">上传限制与缓存</h2>
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Max Package Bytes</label>
                    <input type="number" class="form-control" @bind="form.MaxPackageBytes" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Max File Count</label>
                    <input type="number" class="form-control" @bind="form.MaxFileCount" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Max Single File Bytes</label>
                    <input type="number" class="form-control" @bind="form.MaxSingleFileBytes" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">已发布缓存秒数</label>
                    <input type="number" class="form-control" @bind="form.PublishedCacheSeconds" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">按版本缓存秒数</label>
                    <input type="number" class="form-control" @bind="form.VersionCacheSeconds" />
                </div>
                <div class="col-md-6 d-flex align-items-end">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="resolveAuth" @bind="form.ResolveRequireAuth" />
                        <label class="form-check-label" for="resolveAuth">Resolve 需要鉴权</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-info py-2">@message</div>
    }

    <button class="btn btn-primary" @onclick="SaveAsync">保存</button>
}

@code {
    private StorageForm? form;
    private string secretKey = "";
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var dto = await Http.GetFromJsonAsync<StorageSettingsDto>("/api/settings/storage");
            if (dto is not null)
            {
                form = new StorageForm
                {
                    Provider = dto.Provider,
                    ServiceUrl = dto.ServiceUrl,
                    Region = dto.Region,
                    AccessKey = dto.AccessKey,
                    Bucket = dto.Bucket,
                    Prefix = dto.Prefix,
                    ForcePathStyle = dto.ForcePathStyle,
                    LocalRoot = dto.LocalRoot,
                    MaxPackageBytes = dto.MaxPackageBytes,
                    MaxFileCount = dto.MaxFileCount,
                    MaxSingleFileBytes = dto.MaxSingleFileBytes,
                    ResolveRequireAuth = dto.ResolveRequireAuth,
                    PublishedCacheSeconds = dto.PublishedCacheSeconds,
                    VersionCacheSeconds = dto.VersionCacheSeconds
                };
            }
        }
        catch (Exception ex)
        {
            message = "加载失败: " + ex.Message;
        }
    }

    private async Task SaveAsync()
    {
        if (form is null) return;
        var req = new UpdateStorageSettingsRequest(
            form.Provider, form.ServiceUrl, form.Region, form.AccessKey,
            string.IsNullOrEmpty(secretKey) ? null : secretKey,
            form.Bucket, form.Prefix, form.ForcePathStyle, form.LocalRoot,
            form.MaxPackageBytes, form.MaxFileCount, form.MaxSingleFileBytes,
            form.ResolveRequireAuth, form.PublishedCacheSeconds, form.VersionCacheSeconds);

        var resp = await Http.PutAsJsonAsync("/api/settings/storage", req);
        message = resp.IsSuccessStatusCode ? "已保存" : await resp.Content.ReadAsStringAsync();
    }

    private async Task TestAsync()
    {
        var resp = await Http.PostAsync("/api/settings/storage/test", null);
        message = await resp.Content.ReadAsStringAsync();
    }

    private sealed class StorageForm
    {
        public string Provider { get; set; } = "Local";
        public string? ServiceUrl { get; set; }
        public string Region { get; set; } = "us-east-1";
        public string? AccessKey { get; set; }
        public string Bucket { get; set; } = "static-pages";
        public string Prefix { get; set; } = "";
        public bool ForcePathStyle { get; set; } = true;
        public string LocalRoot { get; set; } = "storage-data";
        public int MaxPackageBytes { get; set; }
        public int MaxFileCount { get; set; }
        public int MaxSingleFileBytes { get; set; }
        public bool ResolveRequireAuth { get; set; }
        public int PublishedCacheSeconds { get; set; }
        public int VersionCacheSeconds { get; set; }
    }
}
