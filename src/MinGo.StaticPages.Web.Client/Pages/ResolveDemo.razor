@page "/resolve-demo"
@rendermode InteractiveAuto
@attribute [Authorize]
@inject HttpClient Http

<PageTitle>解析演示</PageTitle>

<h1>Resolve API 演示</h1>
<p class="muted">模拟数据面 YARP 调用解析接口。</p>

<div class="field">
    <label>项目名</label>
    <input class="form-control" @bind="projectName" />
</div>
<div class="field">
    <label>channel（空=production）</label>
    <input class="form-control" @bind="channel" />
</div>
<div class="field">
    <label>version（指定则优先）</label>
    <input class="form-control" @bind="version" />
</div>
<button class="btn-primary" @onclick="ResolveAsync">解析</button>

@if (!string.IsNullOrEmpty(result))
{
    <pre class="code-block">@result</pre>
}

@code {
    private string projectName = "docs";
    private string channel = "";
    private string version = "";
    private string? result;

    private async Task ResolveAsync()
    {
        var url = $"/api/resolve/{Uri.EscapeDataString(projectName)}";
        var qs = new List<string>();
        if (!string.IsNullOrWhiteSpace(channel)) qs.Add($"channel={Uri.EscapeDataString(channel)}");
        if (!string.IsNullOrWhiteSpace(version)) qs.Add($"version={Uri.EscapeDataString(version)}");
        if (qs.Count > 0) url += "?" + string.Join("&", qs);

        var resp = await Http.GetAsync(url);
        result = $"{(int)resp.StatusCode} {resp.ReasonPhrase}\n{await resp.Content.ReadAsStringAsync()}";
    }
}
