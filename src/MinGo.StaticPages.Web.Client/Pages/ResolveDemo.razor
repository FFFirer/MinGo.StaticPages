@page "/resolve-demo"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@inject HttpClient Http

<PageTitle>解析演示</PageTitle>

<div class="mb-4">
    <h1 class="h3 mb-1">Resolve API 演示</h1>
    <p class="text-body-secondary mb-0">模拟数据面 YARP 调用解析接口。</p>
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">项目名</label>
                <input class="form-control" @bind="projectName" />
            </div>
            <div class="col-md-4">
                <label class="form-label">channel（空=production）</label>
                <input class="form-control" @bind="channel" />
            </div>
            <div class="col-md-4">
                <label class="form-label">version（指定则优先）</label>
                <input class="form-control" @bind="version" />
            </div>
        </div>
        <button class="btn btn-primary mt-3" @onclick="ResolveAsync">解析</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(statusLine))
{
    <div class="card mb-2">
        <div class="card-body py-2">
            <span class="badge @(ok ? "text-bg-success" : "text-bg-danger") me-2">@statusLine</span>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(result))
{
    <pre class="card card-body bg-body-tertiary text-body small mb-0 overflow-auto" style="max-height: 28rem">@result</pre>
}

@code {
    private string projectName = "docs";
    private string channel = "";
    private string version = "";
    private string? statusLine;
    private bool ok;
    private string? result;

    private static readonly System.Text.Json.JsonSerializerOptions PrettyOptions = new()
    {
        WriteIndented = true
    };

    private async Task ResolveAsync()
    {
        var url = $"/api/resolve/{Uri.EscapeDataString(projectName)}";
        var qs = new List<string>();
        if (!string.IsNullOrWhiteSpace(channel)) qs.Add($"channel={Uri.EscapeDataString(channel)}");
        if (!string.IsNullOrWhiteSpace(version)) qs.Add($"version={Uri.EscapeDataString(version)}");
        if (qs.Count > 0) url += "?" + string.Join("&", qs);

        var resp = await Http.GetAsync(url);
        ok = resp.IsSuccessStatusCode;
        statusLine = $"{(int)resp.StatusCode} {resp.ReasonPhrase}";
        result = FormatJson(await resp.Content.ReadAsStringAsync());
    }

    private static string FormatJson(string body)
    {
        if (string.IsNullOrWhiteSpace(body))
            return body;

        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(body);
            return System.Text.Json.JsonSerializer.Serialize(doc.RootElement, PrettyOptions);
        }
        catch (System.Text.Json.JsonException)
        {
            return body;
        }
    }
}
