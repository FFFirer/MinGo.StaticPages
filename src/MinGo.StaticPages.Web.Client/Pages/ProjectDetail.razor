@page "/projects/{Id:guid}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>项目详情</PageTitle>

@if (project is null)
{
    <div class="placeholder-glow"><span class="placeholder col-8"></span></div>
}
else
{
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-4">
        <div>
            <h1 class="h3 mb-1">@project.Name</h1>
            <p class="text-body-secondary mb-0">
                @project.DisplayName · @project.VersionCount 个版本 · @project.StorageBytes.ToString("N0") bytes
            </p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary" @onclick="() => showUpload = true">上传版本</button>
            <button class="btn btn-outline-secondary" @onclick="() => showRollback = true">回滚</button>
        </div>
    </div>

    <h2 class="h5">通道</h2>
    <div class="row g-3 mb-4">
        @foreach (var ch in project.Channels)
        {
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-semibold">@ch.Name</span>
                            <span class="badge text-bg-info">@(ch.CurrentVersionNumber ?? "未发布")</span>
                        </div>
                        @if (versions is not null)
                        {
                            <div class="input-group mb-2">
                                <select class="form-select" @bind="publishVersionId">
                                    <option value="">选择版本…</option>
                                    @foreach (var v in versions.Where(v => v.Status == VersionStatusDto.Active))
                                    {
                                        <option value="@v.Id">@v.Number</option>
                                    }
                                </select>
                                <button class="btn btn-primary" @onclick="() => PublishAsync(ch.Name)">发布</button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <h2 class="h5">版本</h2>
    <div class="card mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-group-divider">
                    <tr>
                        <th>版本号</th>
                        <th>状态</th>
                        <th class="text-end">文件数</th>
                        <th class="text-end">大小</th>
                        <th>上传者</th>
                        <th>时间</th>
                        <th class="text-end">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @if (versions is not null)
                    {
                        @foreach (var v in versions)
                        {
                            <tr>
                                <td><a href="/versions/@v.Id">@v.Number</a></td>
                                <td>
                                    <span class="badge @(v.Status == VersionStatusDto.Active ? "text-bg-success" : "text-bg-secondary")">@v.Status</span>
                                </td>
                                <td class="text-end">@v.FileCount</td>
                                <td class="text-end">@v.SizeBytes.ToString("N0")</td>
                                <td class="text-body-secondary">@v.CreatedBy</td>
                                <td class="text-body-secondary">@v.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="text-end">
                                    @if (v.Status == VersionStatusDto.Active)
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteVersionAsync(v)">删除</button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <h2 class="h5">发布历史</h2>
    <div class="card">
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead class="table-group-divider">
                    <tr>
                        <th>通道</th>
                        <th>动作</th>
                        <th>目标版本</th>
                        <th>操作人</th>
                        <th>时间</th>
                    </tr>
                </thead>
                <tbody>
                    @if (releases is not null)
                    {
                        @foreach (var r in releases)
                        {
                            <tr>
                                <td>@r.ChannelName</td>
                                <td>
                                    <span class="badge @(r.Action == "publish" ? "text-bg-primary" : "text-bg-warning")">@r.Action</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(r.ToVersionNumber))
                                    {
                                        <a href="/versions/@r.ToVersionId">@r.ToVersionNumber</a>
                                    }
                                    else
                                    {
                                        <span class="text-body-secondary">@r.ToVersionId.ToString()[..8]</span>
                                    }
                                </td>
                                <td class="text-body-secondary">@r.OperatorName</td>
                                <td class="text-body-secondary">@r.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (showUpload)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,.35)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5">上传版本</h2>
                    <button type="button" class="btn-close" @onclick="() => showUpload = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">版本号（可选）</label>
                        <input class="form-control" @bind="uploadNumber" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Commit SHA</label>
                        <input class="form-control" @bind="uploadCommit" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Zip 包</label>
                        <InputFile class="form-control" OnChange="OnFileSelected" />
                    </div>
                    @if (!string.IsNullOrEmpty(error))
                    {
                        <div class="alert alert-danger py-2">@error</div>
                    }
                    @if (!string.IsNullOrEmpty(uploadStatus))
                    {
                        <div class="alert alert-info py-2">@uploadStatus</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="() => showUpload = false">关闭</button>
                    <button class="btn btn-primary" disabled="@(file is null || uploading)" @onclick="UploadAsync">上传</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showRollback)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,.35)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5">回滚 production</h2>
                    <button type="button" class="btn-close" @onclick="() => showRollback = false"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">将 production 指回上一个发布版本。</p>
                    @if (!string.IsNullOrEmpty(error))
                    {
                        <div class="alert alert-danger py-2">@error</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="() => showRollback = false">取消</button>
                    <button class="btn btn-danger" @onclick="RollbackAsync">确认回滚</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private ProjectDto? project;
    private List<VersionDto>? versions;
    private List<ReleaseDto>? releases;
    private bool showUpload, showRollback, uploading;
    private string uploadNumber = "", uploadCommit = "", uploadStatus = "";
    private string? error;
    private string publishVersionId = "";
    private IBrowserFile? file;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            project = await Http.GetFromJsonAsync<ProjectDto>($"/api/projects/{Id}");
            versions = await Http.GetFromJsonAsync<List<VersionDto>>($"/api/projects/{Id}/versions");
            releases = await Http.GetFromJsonAsync<List<ReleaseDto>>($"/api/projects/{Id}/releases");
        }
        catch (Exception ex) { error = ex.Message; }
        StateHasChanged();
    }

    private void OnFileSelected(InputFileChangeEventArgs e) => file = e.File;

    private async Task UploadAsync()
    {
        if (file is null) return;
        uploading = true;
        error = null;
        uploadStatus = "上传中…";
        try
        {
            using var content = new MultipartFormDataContent();
            await using var stream = file.OpenReadStream(maxAllowedSize: 256L * 1024 * 1024);
            var sc = new StreamContent(stream);
            sc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/zip");
            content.Add(sc, "file", file.Name);
            if (!string.IsNullOrWhiteSpace(uploadNumber))
                content.Add(new StringContent(uploadNumber), "number");
            if (!string.IsNullOrWhiteSpace(uploadCommit))
                content.Add(new StringContent(uploadCommit), "commitSha");

            var resp = await Http.PostAsync($"/api/projects/{Id}/versions", content);
            if (resp.IsSuccessStatusCode)
            {
                showUpload = false;
                uploadStatus = "";
                await LoadAsync();
            }
            else
            {
                error = await resp.Content.ReadAsStringAsync();
                uploadStatus = "";
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
            uploadStatus = "";
        }
        finally
        {
            uploading = false;
        }
    }

    private async Task PublishAsync(string channel)
    {
        if (string.IsNullOrEmpty(publishVersionId) || !Guid.TryParse(publishVersionId, out var vid))
        {
            await JS.InvokeVoidAsync("alert", "请先选择版本");
            return;
        }
        var resp = await Http.PostAsJsonAsync($"/api/projects/{Id}/publish", new PublishRequest(vid, channel));
        if (!resp.IsSuccessStatusCode)
            await JS.InvokeVoidAsync("alert", await resp.Content.ReadAsStringAsync());
        await LoadAsync();
    }

    private async Task RollbackAsync()
    {
        var resp = await Http.PostAsJsonAsync($"/api/projects/{Id}/rollback", new RollbackRequest("production"));
        if (!resp.IsSuccessStatusCode)
            error = await resp.Content.ReadAsStringAsync();
        else
            showRollback = false;
        await LoadAsync();
    }

    private async Task DeleteVersionAsync(VersionDto v)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"删除版本 {v.Number}？")) return;
        await Http.DeleteAsync($"/api/versions/{v.Id}");
        await LoadAsync();
    }
}
