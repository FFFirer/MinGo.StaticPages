<!DOCTYPE html>
<html lang="zh-CN">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* Theme: 'mingo-theme' = light|dark|auto, read order localStorage -> sessionStorage (session is the fallback when localStorage is unavailable). Classic sync script (not type=module) so it runs before first paint. Keep resolve/read order in sync with wwwroot/js/theme.js. *@
    <script>
        (function () {
            var root = document.documentElement;
            function resolve(mode) {
                if (mode === 'light' || mode === 'dark') return mode;
                try {
                    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                } catch (e) {
                    return 'light';
                }
            }
            function readRaw() {
                var value = null;
                try { value = localStorage.getItem('mingo-theme'); } catch (e) { value = null; }
                if (value === null) {
                    try { value = sessionStorage.getItem('mingo-theme'); } catch (e) { value = null; }
                }
                return value;
            }
            var raw = readRaw();
            var mode = (raw === 'light' || raw === 'dark' || raw === 'auto') ? raw : 'auto';
            root.setAttribute('data-bs-theme', resolve(mode));
            root.setAttribute('data-theme-mode', mode);
        })();
    </script>
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["MinGo.StaticPages.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["lib/bootstrap/dist/js/bootstrap.bundle.min.js"]"></script>
    <script type="module" src="@Assets["js/theme.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
